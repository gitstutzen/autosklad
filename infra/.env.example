# Скопировать в .env и заполнить реальными значениями. Не коммитить .env в git.

POSTGRES_PASSWORD=devpassword

# JWT-секрет, общий для auth и всех сервисов, проверяющих токен (libs/common/auth.py)
JWT_SECRET=change-me-to-a-real-secret

# MS SQL Server — существующая база RoboStorages, используется warehouse-сервисом
# на переходный период параллельного запуска с desktop-клиентом.
# ВАЖНО: пароль от этой базы был найден захардкоженным в исходниках desktop-приложения
# (docs/RoboStorages_анализ_и_миграция_в_web.md, раздел 11) — должен быть заменён
# на новый ДО начала работы над веб-версией, а не только на момент релиза.
WAREHOUSE_MSSQL_DSN=mssql+pyodbc://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@АДРЕС_СЕРВЕРА/ar_stutzen?driver=ODBC+Driver+18+for+SQL+Server

# Честный Знак — государственная система маркировки
CRPT_API_KEY=

# TradeSoft REST API v1 (официальный, www.stutzen.ru/api/v1)
# Токен создаётся в админке Stutzen: Настройки -> Настройки REST API,
# может быть привязан к конкретному IP — зарегистрировать исходящий IP продакшена.
TRADESOFT_API_TOKEN=

# api1c (catalog.stutzen.ru) — неофициальное расширение, см. docs/RoboStorages_scope_MVP.md
API1C_API_KEY=
